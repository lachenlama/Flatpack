# Flatpack web. NEXT_PUBLIC_* values are inlined at BUILD time: set them before `next build`.
NEXT_PUBLIC_DEPLOYMENT=4663                 # shared/deployments/<name>.json ("4663" or "rehearsal")
NEXT_PUBLIC_RPC_URL=                        # default: public RPC from config/mainnet-4663.json (QuickNode-ready)
NEXT_PUBLIC_WC_PROJECT_ID=                  # optional: enables the WalletConnect connector
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_DIST_DIR=.next                         # use .next-b / .next-c for parallel builds
